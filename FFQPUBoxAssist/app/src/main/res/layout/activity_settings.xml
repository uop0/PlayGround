<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:title="@string/settings"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/speed" android:textColor="@color/white" android:textSize="16sp" />
            <com.google.android.material.slider.Slider
                android:id="@+id/speedSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvSpeedVal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/neon_cyan" android:text="300 ms" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swRandom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/random_press"
                android:textColor="@color/white" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/float_size" android:textColor="@color/white" />
            <com.google.android.material.slider.Slider
                android:id="@+id/sizeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/float_alpha" android:textColor="@color/white" />
            <com.google.android.material.slider.Slider
                android:id="@+id/alphaSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/float_shape" android:textColor="@color/white" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/shapeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCircle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Circle" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSquare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Square" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hand" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swVibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vibrate"
                android:textColor="@color/white" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/target_clicks">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/multi" android:textColor="@color/white" />
            <RadioGroup
                android:id="@+id/multiGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/radio1" android:text="1"
                    android:textColor="@color/white" android:checked="true" />
                <RadioButton android:id="@+id/radio2" android:text="2"
                    android:textColor="@color/white" />
                <RadioButton android:id="@+id/radio3" android:text="3"
                    android:textColor="@color/white" />
            </RadioGroup>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
