<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FFQPUBoxAssist" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorSecondary">@color/neon_pink</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/white</item>
        <!-- ضع ملف Cairo.ttf في res/font/cairo.ttf ثم أعد هذا السطر -->
        <!-- <item name="android:fontFamily">@font/cairo</item> -->
    </style>
    <style name="Theme.FFQPUBoxAssist.Splash" parent="Theme.FFQPUBoxAssist">
        <item name="android:windowBackground">@color/black</item>
    </style>
    <style name="GlassCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">#CC12121C</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">8dp</item>
    </style>
    <style name="NeonButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
